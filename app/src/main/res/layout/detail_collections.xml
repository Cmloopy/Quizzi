<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Title Bar - matching quizz_details_full_page layout -->
    <RelativeLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/detailCollectionBtnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_05_back"
            android:layout_alignParentStart="true" />

        <!-- Tiêu đề Education - centered -->
        <TextView
            android:id="@+id/detailCollectionTextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Education"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"/>

        <!-- Edit button matching quizz_details style -->
        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_more_options"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

    <!-- Hình ảnh chính -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/detailCollectionImgBannerWrap"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#F8F5FF"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#6046CC"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleBar">

            <!-- Selected image view (initially hidden) -->
            <ImageView
                android:id="@+id/detailCollectionImgBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Selected Cover Image" />
    </com.google.android.material.card.MaterialCardView>
<!--    <ImageView-->
<!--        android:id="@+id/detailCollectionImgBanner"-->
<!--        android:layout_width="0dp"-->
<!--        android:layout_height="180dp"-->
<!--        android:src="@drawable/img_02"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintTop_toBottomOf="@id/titleBar"-->
<!--        android:layout_marginTop="16dp"-->
<!--        android:layout_marginHorizontal="16dp"-->
<!--        app:layout_constraintDimensionRatio="16:9"-->
<!--        android:scaleType="centerCrop"-->
<!--        android:background="@drawable/top_collections_rounded_background"-->
<!--        android:clipToOutline="true"/>-->

    <!-- Search Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/searchCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detailCollectionImgBannerWrap"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                android:layout_marginEnd="8dp"
                android:alpha="0.6"/>

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search quizzes by name or keywords..."
                android:background="@null"
                android:textSize="16sp"
                android:maxLines="1"
                android:inputType="text"/>

            <ImageView
                android:id="@+id/clearSearchButton"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:alpha="0.6"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Header với số lượng quiz và sort button -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchCardView"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        android:gravity="center_vertical">

        <!-- Số lượng Quizzo -->
        <TextView
            android:id="@+id/detailCollectionTextQuizCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 Quizzo"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Bộ lọc -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sortTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Newest"
            android:drawableRight="@drawable/sort"
            android:drawablePadding="5dp"
            android:textSize="16sp"
            android:textColor="@color/purple"
            android:fontFamily="@font/nunitobold"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"/>

    </LinearLayout>

    <!-- Danh sách Quiz -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/detailCollectionRecyclerQuiz"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="8dp"
        android:padding="16dp"
        android:scrollbars="none"/>

</androidx.constraintlayout.widget.ConstraintLayout>